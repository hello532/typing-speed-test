{
 "sentences": [
  "التمرين قليلا كل يوم يساعد الأصابع على حفظ مواضع المفاتيح.",
  "أبق معصميك مرتاحين وانظر إلى الشاشة بدل النظر إلى لوحة المفاتيح.",
  "الدقة أهم من السرعة عند تعلم الكتابة على الكيبورد.",
  "الجلوس الصحيح يحمي ظهرك ويقلل التعب.",
  "الكتابة دون النظر إلى المفاتيح مهارة تكتسب بالصبر.",
  "من الطبيعي أن تكون بطيئا في البداية، والاستمرار أهم من العجلة.",
  "ضع أصابعك على صف المفاتيح الأوسط قبل البدء.",
  "إذا أخطأت فأصلح الكلمة ثم تابع دون توقف.",
  "تدريب قصير كل يوم أفضل من تدريب طويل مرة في الأسبوع.",
  "سجل سرعتك لترى تحسنك أسبوعا بعد أسبوع.",
  "الكتابة الجيدة توفر الوقت في العمل والدراسة.",
  "اجعل إضاءة الشاشة مريحة حتى لا تتعب عيناك.",
  "استخدم الإصبع الصحيح لكل مفتاح وستلاحظ الفرق.",
  "خذ فترات راحة قصيرة كل ساعة لتجنب إجهاد اليدين.",
  "الإيقاع المنتظم أهم من القفزات المفاجئة في السرعة.",
  "القراءة بصوت عال تحسن مفرداتك وإيقاع كتابتك.",
  "مكتب مرتب وكرسي مريح يساعدان على التركيز.",
  "التدريب اليومي يحول الجهد إلى عادة ثابتة.",
  "المبرمجون يكتبون الشيفرة والملاحظات والتوثيق ساعات طويلة.",
  "تكرار التمارين نفسها يقوي ذاكرة الأصابع.",
  "قبل الاختبار، سخن أصابعك ببضع دقائق من التدريب.",
  "السرعة بلا دقة لا قيمة لها إذا كان النص مليئا بالأخطاء.",
  "ركز على المعنى وستجد يداك المفاتيح تلقائيا.",
  "تعلم الكتابة الجيدة استثمار يفيدك طوال حياتك.",
  "توقف قليلا لتمدد أصابعك وتتجنب ألم المفاصل.",
  "السرعة تأتي وحدها عندما تكون التقنية صحيحة.",
  "انتبه للأخطاء التي تكررها وتدرب على تلك الحروف.",
  "هدف صغير كل يوم يصنع نتيجة كبيرة في نهاية العام.",
  "لا تقارن نفسك بالآخرين بل بنسختك في الأسبوع الماضي.",
  "بالتدريب المستمر يستطيع أي شخص أن يكتب بطلاقة."
 ],
